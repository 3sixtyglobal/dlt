{
	"name": "@3sixty/move-to-json",
	"version": "0.20.0-next.0",
	"description": "CLI for compiling Move contracts and preparing deployment JSON for IOTA networks.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/dlt.git",
		"directory": "packages/move-to-json"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,merge,locales,types,test \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,merge,locales,types \"pnpm run build\" \"pnpm run merge-locales\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@iota/iota-sdk": "1.15.0",
		"@3sixty/cli-core": "next",
		"@3sixty/core": "next",
		"@3sixty/crypto": "next",
		"@3sixty/dlt-account": "0.20.0-next.0",
		"@3sixty/dlt-iota": "0.20.0-next.0",
		"@3sixty/entity-storage-connector-memory": "next",
		"@3sixty/entity-storage-models": "next",
		"@3sixty/nameof": "next",
		"@3sixty/vault-connector-entity-storage": "next",
		"@3sixty/vault-models": "next",
		"@3sixty/wallet-connector-iota": "next",
		"commander": "15.0.0",
		"fast-glob": "3.3.3"
	},
	"devDependencies": {
		"@3sixty/merge-locales": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/validate-locales": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"dotenv": "18.0.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"bin",
		"dist/es",
		"dist/locales",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"move-to-json": "bin/index.js"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dlt"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/dlt/issues"
	},
	"homepage": "https://3sixty.global"
}
