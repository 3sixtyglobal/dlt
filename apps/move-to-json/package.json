{
	"name": "@twin.org/move-to-json",
	"version": "0.0.3-next.14",
	"description": "CLI for compiling Move contracts and preparing deployment JSON for IOTA networks.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-dlt.git",
		"directory": "packages/move-to-json"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales"
	},
	"dependencies": {
		"@iota/iota-sdk": "1.13.0",
		"@twin.org/cli-core": "next",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/dlt-iota": "0.0.3-next.14",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-connector-iota": "next",
		"commander": "14.0.3",
		"fast-glob": "3.3.3"
	},
	"devDependencies": {
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/fs-extra": "11.0.4",
		"@types/node": "25.9.1",
		"@vitest/coverage-v8": "4.1.6",
		"copyfiles": "2.4.1",
		"dotenv": "17.4.2",
		"fs-extra": "11.3.5",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.6"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"bin",
		"dist/es",
		"dist/locales",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"move-to-json": "bin/index.js"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dlt"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-dlt/issues"
	},
	"homepage": "https://twindev.org"
}
