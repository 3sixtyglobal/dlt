{
	"name": "@twin.org/move-to-json",
	"version": "0.0.2-next.10",
	"description": "Tool to convert Move source files to JSON",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/dlt.git",
		"directory": "packages/move-to-json"
	},
	"author": "cornel.filip@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run bundle:esm\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run bundle && npm run test && npm run docs",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales && npm run bundle && npm run docs"
	},
	"dependencies": {
		"@iota/iota-sdk": "1.6.1",
		"@twin.org/cli-core": "next",
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/dlt-iota": "0.0.2-next.10",
		"@twin.org/nameof": "next",
		"@twin.org/wallet-connector-iota": "next",
		"commander": "14.0.1",
		"fast-glob": "3.3.3"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/entity-storage-models": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/fs-extra": "11.0.4",
		"@types/node": "24.7.0",
		"@vitest/coverage-v8": "3.2.4",
		"copyfiles": "2.4.1",
		"dotenv": "17.2.3",
		"fs-extra": "11.3.2",
		"nodemon": "3.1.10",
		"rimraf": "6.0.1",
		"rollup": "4.52.4",
		"ts-patch": "3.3.0",
		"typedoc": "0.28.13",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		}
	},
	"files": [
		"bin",
		"dist/cjs",
		"dist/esm",
		"dist/locales",
		"dist/types",
		"locales",
		"docs"
	],
	"bin": {
		"move-to-json": "bin/index.js"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"dlt"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/dlt/issues"
	},
	"homepage": "https://twindev.org"
}
