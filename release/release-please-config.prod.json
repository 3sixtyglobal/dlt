{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"group-pull-request-title-pattern": "chore: release ${branch}",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"last-release-sha": "e8b755552812fbfa7822da6d98af4bc47681302b",
	"packages": {
		"packages/dlt-account": {
			"package-name": "dlt-account",
			"changelog-path": "docs/changelog.md"
		},
		"packages/dlt-iota": {
			"package-name": "dlt-iota",
			"changelog-path": "docs/changelog.md"
		},
		"apps/move-to-json": {
			"package-name": "move-to-json",
			"changelog-path": "docs/changelog.md",
			"extra-files": [
				"src/cli.ts"
			]
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"dlt-account",
				"dlt-iota",
				"move-to-json"
			]
		}
	]
}
