{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog",
		"devnet.env.*",
		"mainnet.env.*",
		"testnet.env.*"
	],
	"words": [
		"abbrev",
		"adduser",
		"allkeys",
		"autorelease",
		"autorestart",
		"bech",
		"BGSAVE",
		"BUILDKIT",
		"buildx",
		"childlogdir",
		"Cleanup",
		"devnet",
		"envsubst",
		"FAUCET",
		"FLUSHALL",
		"FLUSHDB",
		"HKLM",
		"hotfixes",
		"keepalive",
		"keytool",
		"localnet",
		"loglevel",
		"longpaths",
		"maxmemory",
		"multiarch",
		"nameof",
		"Nanos",
		"nodaemon",
		"pidfile",
		"procps",
		"requirepass",
		"rpcinterface",
		"Secp",
		"serverurl",
		"startretries",
		"Stdlib",
		"Stiftung",
		"supervisorctl",
		"supervisord",
		"twinfoundation",
		"martynjanesiota",
		"LASTEXITCODE",
		"netsh",
		"excludedportrange"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm",
		"/tst1.*/"
	]
}
